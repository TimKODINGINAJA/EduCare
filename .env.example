# ============================================================
# EduCare - Contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi nilai asli.
# `.env` TIDAK di-commit ke git (lihat .gitignore), sehingga
# kredensial tetap aman saat project di-push ke GitHub.
# ============================================================

# SMTP (dipakai untuk fitur reset password via PHPMailer)
# Contoh untuk Gmail (gunakan "App Password" Gmail, bukan password akun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EduCare Official

# DeepL Automatic Translation (optional). Leave DEEPL_API_KEY empty to
# keep the app running in the original Indonesian text (safe fallback).
DEEPL_ENABLED=true
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
